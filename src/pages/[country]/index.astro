---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { getCountryNote, loadCountryNotes } from "../../lib/countries";
import { loadLocations } from "../../lib/locations";

export function getStaticPaths() {
  return loadCountryNotes().map((country) => ({
    params: { country: country.slug },
  }));
}

const countrySlug = Astro.params.country ?? "";
const country = getCountryNote(countrySlug);
if (!country) throw new Error(`Unknown country route: ${countrySlug}`);

const base = import.meta.env.BASE_URL;
const countryLocations = loadLocations().filter(
  (location) => location.countrySlug === country.slug,
);
---

<BaseLayout
  title={`${country.nameZh} · Geo Pub`}
  description={country.summary}
>
  <SiteHeader />
  <main class="country-page">
    <header class="country-hero">
      <div class="country-hero__inner">
        <a class="back-link" href={base}>← 返回世界地图</a>
        <p class="country-kicker">COUNTRY NOTE · {country.iso2}</p>
        <h1>{country.nameZh}</h1>
        <p class="country-name-en">{country.title}</p>
        <p class="country-summary">{country.summary}</p>
        <div class="country-meta">
          <span>{countryLocations.length} 个点位</span>
          <span>更新于 {country.updatedAt}</span>
        </div>
      </div>
    </header>

    <div class="country-layout">
      <article class="country-article prose" set:html={country.html} />

      <aside class="country-locations" aria-labelledby="location-index-title">
        <div class="section-heading">
          <p>MAP INDEX</p>
          <h2 id="location-index-title">地图点位</h2>
        </div>
        <div class="location-index-list">
          {
            countryLocations.map((location, index) => (
              <a
                class="location-index-item"
                href={`${base}?location=${encodeURIComponent(location.id)}`}
              >
                <span class="location-index-item__number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>
                  <strong>{location.title}</strong>
                  <small>{location.summary}</small>
                </span>
                <span class="location-index-item__arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            ))
          }
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

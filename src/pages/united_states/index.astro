---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import UnitedStatesNote, {
  frontmatter,
} from "../../content/countries/united_states.md";
import { locations } from "../../lib/locations";

const base = import.meta.env.BASE_URL;
const countryLocations = locations.filter(
  (location) => location.countrySlug === "united_states",
);
---

<BaseLayout
  title={`${frontmatter.nameZh} · Geo Pub`}
  description={frontmatter.summary}
>
  <SiteHeader />
  <main class="country-page">
    <header class="country-hero">
      <div class="country-hero__inner">
        <a class="back-link" href={base}>← 返回世界地图</a>
        <p class="country-kicker">COUNTRY NOTE · {frontmatter.iso2}</p>
        <h1>{frontmatter.nameZh}</h1>
        <p class="country-name-en">{frontmatter.title}</p>
        <p class="country-summary">{frontmatter.summary}</p>
        <div class="country-meta">
          <span>{countryLocations.length} 个点位</span>
          <span>更新于 {frontmatter.updatedAt}</span>
        </div>
      </div>
    </header>

    <div class="country-layout">
      <article class="country-article prose">
        <UnitedStatesNote />
      </article>

      <aside class="country-locations" aria-labelledby="location-index-title">
        <div class="section-heading">
          <p>MAP INDEX</p>
          <h2 id="location-index-title">地图点位</h2>
        </div>
        <div class="location-index-list">
          {
            countryLocations.map((location, index) => (
              <a
                class="location-index-item"
                href={`${base}?location=${encodeURIComponent(location.id)}`}
              >
                <span class="location-index-item__number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>
                  <strong>{location.title}</strong>
                  <small>{location.summary}</small>
                </span>
                <span class="location-index-item__arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            ))
          }
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

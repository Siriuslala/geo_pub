---
import "maplibre-gl/dist/maplibre-gl.css";
import { loadCountryMapPages } from "../lib/countries";
import { loadLocations } from "../lib/locations";

const apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ?? "";
const base = import.meta.env.BASE_URL;
const locations = loadLocations();
const countryMapPages = loadCountryMapPages();
---

<section
  class="map-workspace"
  id="map-workspace"
  data-api-key={apiKey}
  data-base={base}
  aria-label="图寻世界地图"
>
  <div id="world-map" class="world-map" aria-label="可拖拽和缩放的世界地图"></div>

  <div class="map-toolbar" aria-label="地图摘要">
    <div>
      <span class="map-toolbar__eyebrow">WORLD INDEX</span>
      <strong>{locations.length} 个示例点位</strong>
    </div>
    <span class="map-toolbar__country">
      <span class="country-dot" aria-hidden="true"></span>
      {countryMapPages.length} 个国家资料
    </span>
  </div>

  <div class="map-mode-switcher" role="group" aria-label="地图显示模式">
    <button type="button" data-map-mode="simple" aria-pressed="false">
      简洁
    </button>
    <button type="button" data-map-mode="terrain" aria-pressed="true">
      地形
    </button>
  </div>

  <div class="preview-source-switcher" role="group" aria-label="街景缩略图来源">
    <button type="button" data-preview-source="google" aria-pressed="true">
      谷歌
    </button>
    <button type="button" data-preview-source="local" aria-pressed="false">
      國內
    </button>
  </div>

  <div class="map-legend" aria-label="地图图例">
    <span><i class="legend-swatch legend-swatch--location"></i>街景点位</span>
  </div>

  <aside
    id="location-panel"
    class="location-panel"
    aria-live="polite"
    aria-label="地点街景信息"
    hidden
  >
    <button
      class="location-panel__close"
      id="location-panel-close"
      type="button"
      aria-label="关闭地点信息"
      title="关闭"
    >
      ×
    </button>
    <div id="location-panel-content"></div>
  </aside>

  <div class="map-loading" id="map-loading" role="status">
    <span></span>
    正在加载中
  </div>

  <div
    class="street-view-lightbox"
    id="street-view-lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="放大街景"
    hidden
  >
    <button
      type="button"
      class="street-view-lightbox__backdrop"
      id="street-view-lightbox-backdrop"
      aria-label="关闭放大街景"
    ></button>
    <figure class="street-view-lightbox__frame">
      <img id="street-view-lightbox-image" alt="" />
      <button
        type="button"
        class="street-view-media-toggle street-view-media-toggle--collapse"
        id="street-view-lightbox-collapse"
        aria-label="缩小街景"
        title="缩小"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path
            d="M6 2v4H2M10 2v4h4M6 14v-4H2M10 14v-4h4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
    </figure>
  </div>

  <noscript>
    <div class="map-fallback">地图需要启用 JavaScript。</div>
  </noscript>

  <script
    is:inline
    id="geo-pub-location-data"
    type="application/json"
    set:html={JSON.stringify(locations)}
  ></script>
  <script
    is:inline
    id="geo-pub-country-data"
    type="application/json"
    set:html={JSON.stringify(countryMapPages)}
  ></script>
</section>

<script>
  import {
    AJAXError,
    AttributionControl,
    GPUInitializationError,
    Map as MapLibreMap,
    NavigationControl,
    setWorkerUrl,
    type DataDrivenPropertyValueSpecification,
    type MapGeoJSONFeature,
    type MapLayerMouseEvent,
    type MapMouseEvent,
    type PointLike,
  } from "maplibre-gl";
  import mapLibreWorkerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";
  import { feature as topojsonFeature } from "topojson-client";
  import worldTopology from "world-atlas/countries-110m.json";
  import type {
    FeatureCollection,
    GeoJsonProperties,
    Geometry,
    Point,
  } from "geojson";
  import type {
    GeometryCollection,
    Topology,
  } from "topojson-specification";
  import type { GeoLocation, StreetView } from "../lib/locations";

  const workspace = document.querySelector<HTMLElement>("#map-workspace");
  const mapElement = document.querySelector<HTMLElement>("#world-map");
  const loadingElement = document.querySelector<HTMLElement>("#map-loading");
  const panel = document.querySelector<HTMLElement>("#location-panel");
  const panelContent = document.querySelector<HTMLElement>(
    "#location-panel-content",
  );
  const panelClose = document.querySelector<HTMLButtonElement>(
    "#location-panel-close",
  );
  const lightbox = document.querySelector<HTMLElement>("#street-view-lightbox");
  const lightboxBackdrop = document.querySelector<HTMLButtonElement>(
    "#street-view-lightbox-backdrop",
  );
  const lightboxImage = document.querySelector<HTMLImageElement>(
    "#street-view-lightbox-image",
  );
  const lightboxCollapse = document.querySelector<HTMLButtonElement>(
    "#street-view-lightbox-collapse",
  );
  const dataElement = document.querySelector<HTMLScriptElement>(
    "#geo-pub-location-data",
  );
  const countryDataElement = document.querySelector<HTMLScriptElement>(
    "#geo-pub-country-data",
  );
  const modeButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-map-mode]"),
  );
  const previewSourceButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-preview-source]"),
  );

  if (
    !workspace ||
    !mapElement ||
    !loadingElement ||
    !panel ||
    !panelContent ||
    !panelClose ||
    !lightbox ||
    !lightboxBackdrop ||
    !lightboxImage ||
    !lightboxCollapse ||
    !dataElement ||
    !countryDataElement ||
    modeButtons.length !== 2 ||
    previewSourceButtons.length !== 2
  ) {
    throw new Error("Geo Pub map markup is incomplete.");
  }

  document.body.append(lightbox);
  setWorkerUrl(mapLibreWorkerUrl);

  const apiKey = workspace.dataset.apiKey ?? "";
  const baseUrl = workspace.dataset.base ?? "/geo_pub/";
  const locationList = JSON.parse(dataElement.textContent ?? "[]") as GeoLocation[];
  const locationById = new Map(
    locationList.map((location) => [location.id, location]),
  );
  const countryPages = JSON.parse(countryDataElement.textContent ?? "[]") as Array<{
    slug: string;
    iso2: string;
    isoNumeric: string;
    title: string;
    nameZh: string;
  }>;
  const countryPagesByIso2 = Object.fromEntries(
    countryPages.map((country) => [country.iso2, country]),
  );
  const countryPagesByIsoNumeric = Object.fromEntries(
    countryPages.map((country) => [country.isoNumeric, country]),
  );

  const topology = worldTopology as unknown as Topology<{
    countries: GeometryCollection<GeoJsonProperties>;
  }>;
  const worldCountries = topojsonFeature(
    topology,
    topology.objects.countries,
  ) as unknown as FeatureCollection<Geometry, GeoJsonProperties>;

  for (const country of worldCountries.features) {
    const numericId = String(country.id ?? "").padStart(3, "0");
    const page = countryPagesByIsoNumeric[numericId];
    country.properties = {
      ...(country.properties ?? {}),
      numericId,
      pageSlug: page?.slug ?? "",
    };
  }

  const countryLabelLayerIds = [
    "label_country_1",
    "label_country_2",
    "label_country_3",
  ];
  const publishedCountryColor = "#176f72";

  const locationGeoJson: FeatureCollection<Point> = {
    type: "FeatureCollection",
    features: locationList.map((location) => ({
      type: "Feature",
      geometry: { type: "Point", coordinates: location.coordinates },
      properties: {
        id: location.id,
        title: location.title,
        countrySlug: location.countrySlug,
        minZoom: location.minZoom,
      },
    })),
  };

  const STYLE_URL = "https://tiles.openfreemap.org/styles/positron";
  const LOADING_TIMEOUT_MS = 20_000;
  let mapReady = false;
  let loadingTimeout: number | undefined;

  const clearLoadingTimeout = () => {
    if (!loadingTimeout) return;
    window.clearTimeout(loadingTimeout);
    loadingTimeout = undefined;
  };

  const hideLoading = () => {
    loadingElement.hidden = true;
    loadingElement.classList.remove("has-error");
    clearLoadingTimeout();
  };

  const showFatalError = (message: string) => {
    if (mapReady) return;
    clearLoadingTimeout();

    const label = document.createElement("span");
    label.className = "map-loading__message";
    label.textContent = message;

    const retry = document.createElement("button");
    retry.type = "button";
    retry.className = "map-loading__retry";
    retry.textContent = "重试";
    retry.addEventListener("click", () => {
      window.location.reload();
    });

    loadingElement.hidden = false;
    loadingElement.classList.add("has-error");
    loadingElement.replaceChildren(label, retry);
  };

  const armLoadingTimeout = () => {
    clearLoadingTimeout();
    loadingTimeout = window.setTimeout(() => {
      if (!mapReady) showFatalError("地图加载超时，请检查网络后重试");
    }, LOADING_TIMEOUT_MS);
  };

  const isFatalMapError = (error: unknown) => {
    if (error instanceof GPUInitializationError) return true;
    if (!(error instanceof AJAXError) || !error.url) return false;

    try {
      const { hostname, pathname } = new URL(error.url);
      return hostname === "tiles.openfreemap.org" && pathname.startsWith("/styles/");
    } catch {
      return false;
    }
  };

  const map = new MapLibreMap({
    container: mapElement,
    style: STYLE_URL,
    center: [8, 24],
    zoom: 1.35,
    minZoom: 1,
    maxZoom: 14,
    renderWorldCopies: true,
    attributionControl: false,
  });

  armLoadingTimeout();

  map.addControl(
    new NavigationControl({ showCompass: false }),
    "bottom-right",
  );
  map.addControl(
    new AttributionControl({ compact: true }),
    "bottom-right",
  );

  let activeLocationId: string | null = null;
  let panelPinned = false;
  let showTimer: number | undefined;
  let closeTimer: number | undefined;
  let lastPointerPoint = { x: 120, y: 160 };
  let currentMapMode: "simple" | "terrain" = "terrain";
  let currentPreviewSource: "google" | "local" = "google";
  let expandedCard: HTMLElement | null = null;

  const terrainLayerIds = [
    "terrain-natural-earth",
    "terrain-landcover",
    "terrain-landuse",
    "terrain-water",
    "terrain-waterways",
    "terrain-mountain-peaks",
    "terrain-mountain-labels",
  ];

  const setMapMode = (mode: "simple" | "terrain") => {
    currentMapMode = mode;
    const visibility = mode === "terrain" ? "visible" : "none";

    for (const layerId of terrainLayerIds) {
      if (map.getLayer(layerId)) {
        map.setLayoutProperty(layerId, "visibility", visibility);
      }
    }

    for (const layerId of ["park", "landcover_wood"]) {
      if (map.getLayer(layerId)) {
        map.setLayoutProperty(
          layerId,
          "visibility",
          mode === "terrain" ? "none" : "visible",
        );
      }
    }

    workspace.dataset.mapMode = mode;
    for (const button of modeButtons) {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.mapMode === mode),
      );
    }
  };

  for (const button of modeButtons) {
    button.addEventListener("click", () => {
      const mode = button.dataset.mapMode;
      if (mode === "simple" || mode === "terrain") setMapMode(mode);
    });
  }

  const cancelTimers = () => {
    if (showTimer) window.clearTimeout(showTimer);
    if (closeTimer) window.clearTimeout(closeTimer);
    showTimer = undefined;
    closeTimer = undefined;
  };

  const joinBase = (path: string) =>
    `${baseUrl.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;

  const getViewpoint = (
    location: GeoLocation,
    streetView: StreetView,
  ): [number, number] => streetView.viewpoint ?? location.coordinates;

  const buildStaticImageUrl = (
    location: GeoLocation,
    streetView: StreetView,
    usePanoId = true,
  ) => {
    const [lng, lat] = getViewpoint(location, streetView);
    const parameters = new URLSearchParams({
      size: "640x360",
      heading: String(streetView.heading),
      pitch: String(streetView.pitch),
      fov: String(streetView.fov),
      return_error_code: "true",
      key: apiKey,
    });

    if (usePanoId && streetView.panoId) {
      parameters.set("pano", streetView.panoId);
    } else {
      parameters.set("location", `${lat},${lng}`);
    }

    // source=outdoor drops user Photo Spheres during location search.
    if (!streetView.panoId?.startsWith("CAoS")) {
      parameters.set("source", "outdoor");
    }

    return `https://maps.googleapis.com/maps/api/streetview?${parameters.toString()}`;
  };

  const buildGoogleMapsUrl = (
    location: GeoLocation,
    streetView: StreetView,
  ) => {
    if (streetView.google_map_url) return streetView.google_map_url;

    const [lng, lat] = getViewpoint(location, streetView);
    const parameters = new URLSearchParams({
      api: "1",
      map_action: "pano",
      viewpoint: `${lat},${lng}`,
      heading: String(streetView.heading),
      pitch: String(streetView.pitch),
      fov: String(Math.min(streetView.fov, 100)),
      utm_source: "geo_pub",
      utm_campaign: "street_view_preview",
    });
    if (streetView.panoId) parameters.set("pano", streetView.panoId);
    return `https://www.google.com/maps/@?${parameters.toString()}`;
  };

  const createTextElement = (
    tagName: keyof HTMLElementTagNameMap,
    className: string,
    text: string,
  ) => {
    const element = document.createElement(tagName);
    element.className = className;
    element.textContent = text;
    return element;
  };

  const sizeLightboxImage = (naturalWidth: number, naturalHeight: number) => {
    const width = naturalWidth || 640;
    const height = naturalHeight || 360;
    const maxWidth = Math.min(window.innerWidth * 0.92, 1600);
    const maxHeight = Math.min(window.innerHeight * 0.86, 900);
    const scale = Math.min(maxWidth / width, maxHeight / height);
    lightboxImage.style.width = `${width * scale}px`;
    lightboxImage.style.height = `${height * scale}px`;
  };

  const closeLightbox = () => {
    if (lightbox.hidden) return;
    lightbox.hidden = true;
    lightboxImage.removeAttribute("src");
    lightboxImage.removeAttribute("width");
    lightboxImage.removeAttribute("height");
    lightboxImage.removeAttribute("style");
    lightboxImage.alt = "";
    expandedCard?.classList.remove("is-expanded");
    expandedCard = null;
  };

  const openLightbox = (card: HTMLElement) => {
    const image = card.querySelector("img");
    if (!image?.src) return;

    const naturalWidth = image.naturalWidth || 640;
    const naturalHeight = image.naturalHeight || 360;
    cancelTimers();
    expandedCard?.classList.remove("is-expanded");
    expandedCard = card;
    card.classList.add("is-expanded");
    lightboxImage.alt = image.alt;
    lightboxImage.src = image.currentSrc || image.src;
    sizeLightboxImage(naturalWidth, naturalHeight);
    lightbox.hidden = false;
    lightboxCollapse.focus();
  };

  const usesLocalPreview = (streetView: StreetView) =>
    Boolean(!streetView.google_map_url && streetView.local_image_path);

  const getPreviewUrl = (location: GeoLocation, streetView: StreetView) => {
    if (usesLocalPreview(streetView)) {
      return joinBase(streetView.local_image_path);
    }
    if (currentPreviewSource === "google") {
      return apiKey ? buildStaticImageUrl(location, streetView) : "";
    }
    return streetView.local_image_path
      ? joinBase(streetView.local_image_path)
      : "";
  };

  const loadPreview = (
    card: HTMLElement,
    location: GeoLocation,
    streetView: StreetView,
  ) => {
    if (card.dataset.loaded === "true") return;

    const imageUrl = getPreviewUrl(location, streetView);
    if (!imageUrl) return;

    const host =
      card.querySelector<HTMLElement>(".street-view-card__link") ?? card;
    card.dataset.loaded = "true";
    card.classList.add("is-loading");

    const image = new Image();
    image.alt = streetView.alt;
    image.width = 640;
    image.height = 360;
    image.decoding = "async";
    image.loading = "eager";
    image.fetchPriority = "high";
    image.referrerPolicy = "strict-origin-when-cross-origin";
    let attemptedCoordinateFallback = false;
    image.addEventListener("load", () => {
      card.classList.remove("is-loading");
      card.classList.add("is-loaded");
    });
    image.addEventListener("error", () => {
      if (
        !usesLocalPreview(streetView) &&
        currentPreviewSource === "google" &&
        streetView.panoId &&
        !attemptedCoordinateFallback
      ) {
        attemptedCoordinateFallback = true;
        image.src = buildStaticImageUrl(location, streetView, false);
        return;
      }

      image.remove();
      card.classList.remove("is-loading");
      card.classList.add("has-error");
      const state = card.querySelector<HTMLElement>(".street-view-card__state");
      if (state) {
        state.textContent =
          usesLocalPreview(streetView) || currentPreviewSource === "local"
            ? "本地缩略图载入失败"
            : "街景预览暂时不可用";
      }
    });
    image.src = imageUrl;
    host.prepend(image);
  };

  const renderLocation = (location: GeoLocation) => {
    closeLightbox();
    panelContent.replaceChildren();

    const heading = document.createElement("header");
    heading.className = "location-panel__header";
    heading.append(createTextElement("h2", "location-panel__title", location.title));

    const mediaRail = document.createElement("div");
    mediaRail.className = "street-view-rail";
    mediaRail.classList.toggle(
      "street-view-rail--single",
      location.streetViews.length === 1,
    );
    mediaRail.setAttribute("aria-label", "街景预览");

    location.streetViews.forEach((streetView) => {
      const card = document.createElement("div");
      card.className = "street-view-card";

      const link = document.createElement("a");
      link.className = "street-view-card__link";
      if (streetView.google_map_url) {
        link.href = buildGoogleMapsUrl(location, streetView);
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.setAttribute(
          "aria-label",
          `${streetView.caption}，在 Google Maps 中打开`,
        );
      } else {
        link.setAttribute("aria-label", streetView.caption);
      }

      const previewUrl = getPreviewUrl(location, streetView);
      const hasPreview = Boolean(previewUrl);
      const localOnly = usesLocalPreview(streetView);

      const state = createTextElement(
        "span",
        "street-view-card__state",
        localOnly || currentPreviewSource === "local"
          ? streetView.local_image_path
            ? "载入本地缩略图"
            : "本地缩略图待添加"
          : apiKey
            ? "载入街景"
            : "街景预览待连接",
      );
      card.classList.toggle("has-no-preview", !hasPreview);
      link.append(state);

      const expand = document.createElement("button");
      expand.type = "button";
      expand.className = "street-view-media-toggle street-view-media-toggle--expand";
      expand.setAttribute("aria-label", "放大街景");
      expand.title = "放大";
      expand.innerHTML =
        '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2H2v4M10 2h4v4M6 14H2v-4M10 14h4v-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
      expand.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        openLightbox(card);
      });

      card.append(link, expand);
      mediaRail.append(card);
      if (hasPreview) loadPreview(card, location, streetView);
    });

    if (location.streetViews.length > 1) {
      mediaRail.addEventListener(
        "wheel",
        (event) => {
          if (mediaRail.scrollWidth <= mediaRail.clientWidth) return;
          if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;

          event.preventDefault();
          const delta =
            event.deltaMode === 1
              ? event.deltaY * 16
              : event.deltaMode === 2
                ? event.deltaY * mediaRail.clientWidth
                : event.deltaY;
          mediaRail.scrollLeft += delta;
        },
        { passive: false },
      );
    }

    const body = document.createElement("div");
    body.className = "location-panel__body";
    body.append(createTextElement("p", "location-panel__summary", location.summary));

    panelContent.append(heading, mediaRail, body);
  };

  const setPreviewSource = (source: "google" | "local") => {
    if (currentPreviewSource === source) return;
    currentPreviewSource = source;
    workspace.dataset.previewSource = source;

    for (const button of previewSourceButtons) {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.previewSource === source),
      );
    }

    const activeLocation = activeLocationId
      ? locationById.get(activeLocationId)
      : undefined;
    if (activeLocation && !panel.hidden) {
      renderLocation(activeLocation);
      requestAnimationFrame(() => positionPanel());
    }
  };

  for (const button of previewSourceButtons) {
    button.addEventListener("click", () => {
      const source = button.dataset.previewSource;
      if (source === "google" || source === "local") {
        setPreviewSource(source);
      }
    });
  }

  const PANEL_KEEP_RADIUS_PX = 96 / 2.54;

  const isCompactLayout = () => window.matchMedia("(max-width: 720px)").matches;

  const isInPanelKeepZone = (clientX: number, clientY: number) => {
    if (panel.hidden || isCompactLayout()) return false;

    const rect = panel.getBoundingClientRect();
    if (
      clientX >= rect.left &&
      clientX <= rect.right &&
      clientY >= rect.top &&
      clientY <= rect.bottom
    ) {
      return true;
    }

    const dx = clientX - rect.left;
    const dy = clientY - rect.top;
    return dx * dx + dy * dy <= PANEL_KEEP_RADIUS_PX * PANEL_KEEP_RADIUS_PX;
  };

  const clientPointFromMapEvent = (event: MapMouseEvent | MapLayerMouseEvent) => {
    const original = event.originalEvent;
    if (original instanceof MouseEvent) {
      return { x: original.clientX, y: original.clientY };
    }
    const workspaceRect = workspace.getBoundingClientRect();
    return {
      x: workspaceRect.left + event.point.x,
      y: workspaceRect.top + event.point.y,
    };
  };

  const positionPanel = (point = lastPointerPoint) => {
    if (isCompactLayout()) {
      panel.style.removeProperty("left");
      panel.style.removeProperty("top");
      return;
    }

    const workspaceRect = workspace.getBoundingClientRect();
    const panelRect = panel.getBoundingClientRect();
    const gap = 18;
    const padding = 12;
    let left = point.x + gap;
    let top = point.y + gap;

    if (left + panelRect.width > workspaceRect.width - padding) {
      left = point.x - panelRect.width - gap;
    }
    if (top + panelRect.height > workspaceRect.height - padding) {
      top = point.y - panelRect.height - gap;
    }

    panel.style.left = `${Math.max(padding, left)}px`;
    panel.style.top = `${Math.max(padding, top)}px`;
  };

  const showLocation = (
    location: GeoLocation,
    point = lastPointerPoint,
    pinned = false,
  ) => {
    cancelTimers();
    activeLocationId = location.id;
    panelPinned = pinned;
    lastPointerPoint = point;
    renderLocation(location);
    panel.hidden = false;
    panel.classList.toggle("is-pinned", panelPinned);
    requestAnimationFrame(() => positionPanel(point));
  };

  const hidePanel = (force = false) => {
    if (!lightbox.hidden && !force) return;
    if (panelPinned && !force) return;
    closeLightbox();
    cancelTimers();
    panel.hidden = true;
    panelPinned = false;
    panel.classList.remove("is-pinned");
    activeLocationId = null;
  };

  const scheduleLocation = (location: GeoLocation, point: { x: number; y: number }) => {
    if (panelPinned) return;

    if (activeLocationId === location.id && !panel.hidden) {
      cancelTimers();
      return;
    }

    if (!panel.hidden) {
      showLocation(location, point);
      return;
    }

    lastPointerPoint = point;
    if (showTimer) window.clearTimeout(showTimer);
    showTimer = window.setTimeout(() => showLocation(location, point), 250);
  };

  const scheduleClose = () => {
    if (!lightbox.hidden) return;
    if (showTimer) window.clearTimeout(showTimer);
    showTimer = undefined;
    if (panelPinned) return;
    if (closeTimer) return;
    closeTimer = window.setTimeout(() => hidePanel(), 180);
  };

  const getLocationFromFeatures = (features?: MapGeoJSONFeature[]) => {
    const id = features?.[0]?.properties?.id;
    return typeof id === "string" ? locationById.get(id) : undefined;
  };

  map.on("load", () => {
    mapReady = true;
    hideLoading();

    map.addLayer(
      {
        id: "terrain-natural-earth",
        type: "raster",
        source: "ne2_shaded",
        maxzoom: 7,
        layout: { visibility: "none" },
        paint: {
          "raster-opacity": 0.48,
          "raster-saturation": 0.18,
          "raster-contrast": 0.12,
        },
      },
      "park",
    );
    map.addLayer(
      {
        id: "terrain-landcover",
        type: "fill",
        source: "openmaptiles",
        "source-layer": "landcover",
        minzoom: 1,
        filter: [
          "match",
          ["get", "class"],
          ["wood", "grass", "sand", "rock", "wetland", "ice"],
          true,
          false,
        ],
        layout: { visibility: "none" },
        paint: {
          "fill-color": [
            "match",
            ["get", "class"],
            "wood",
            "#72966f",
            "grass",
            "#b4c58a",
            "sand",
            "#d8c78d",
            "rock",
            "#aaa39a",
            "wetland",
            "#86aaa0",
            "ice",
            "#dce9e8",
            "#c9c6a9",
          ],
          "fill-opacity": [
            "interpolate",
            ["linear"],
            ["zoom"],
            1,
            0.48,
            6,
            0.66,
            12,
            0.56,
          ],
        },
      },
      "park",
    );
    map.addLayer(
      {
        id: "terrain-landuse",
        type: "fill",
        source: "openmaptiles",
        "source-layer": "landuse",
        minzoom: 4,
        filter: [
          "match",
          ["get", "class"],
          [
            "farmland",
            "farmyard",
            "orchard",
            "vineyard",
            "allotments",
            "meadow",
            "grass",
            "recreation_ground",
            "quarry",
          ],
          true,
          false,
        ],
        layout: { visibility: "none" },
        paint: {
          "fill-color": [
            "match",
            ["get", "class"],
            ["farmland", "farmyard"],
            "#cfc58d",
            ["orchard", "vineyard", "allotments"],
            "#9eb47c",
            ["meadow", "grass", "recreation_ground"],
            "#b9ca91",
            "quarry",
            "#aaa29a",
            "#c5c1a8",
          ],
          "fill-opacity": 0.56,
        },
      },
      "park",
    );
    map.addLayer(
      {
        id: "terrain-water",
        type: "fill",
        source: "openmaptiles",
        "source-layer": "water",
        filter: ["!=", ["get", "brunnel"], "tunnel"],
        layout: { visibility: "none" },
        paint: {
          "fill-color": "#8dbbc5",
          "fill-opacity": 0.92,
        },
      },
      "landcover_ice_shelf",
    );
    map.addLayer(
      {
        id: "terrain-waterways",
        type: "line",
        source: "openmaptiles",
        "source-layer": "waterway",
        layout: { visibility: "none" },
        paint: {
          "line-color": "#6fabb9",
          "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.6, 12, 1.8],
          "line-opacity": 0.9,
        },
      },
      "building",
    );
    map.addLayer(
      {
        id: "terrain-mountain-peaks",
        type: "circle",
        source: "openmaptiles",
        "source-layer": "mountain_peak",
        minzoom: 7,
        filter: ["<=", ["coalesce", ["get", "rank"], 99], 12],
        layout: { visibility: "none" },
        paint: {
          "circle-color": "#665d55",
          "circle-radius": ["interpolate", ["linear"], ["zoom"], 7, 2, 12, 3.5],
          "circle-stroke-color": "#f8f5ea",
          "circle-stroke-width": 1,
        },
      },
      "waterway_line_label",
    );
    map.addLayer(
      {
        id: "terrain-mountain-labels",
        type: "symbol",
        source: "openmaptiles",
        "source-layer": "mountain_peak",
        minzoom: 8,
        filter: ["<=", ["coalesce", ["get", "rank"], 99], 12],
        layout: {
          visibility: "none",
          "text-field": [
            "coalesce",
            ["get", "name:zh-Hans"],
            ["get", "name:zh"],
            ["get", "name"],
            "",
          ],
          "text-font": ["Noto Sans Regular"],
          "text-size": 11,
          "text-offset": [0, 0.85],
          "text-anchor": "top",
          "text-optional": true,
        },
        paint: {
          "text-color": "#554d47",
          "text-halo-color": "rgba(248, 245, 234, 0.9)",
          "text-halo-width": 1.4,
        },
      },
      "waterway_line_label",
    );

    map.addLayer(
      {
        id: "country-subdivision-boundaries",
        type: "line",
        source: "openmaptiles",
        "source-layer": "boundary",
        minzoom: 3,
        maxzoom: 8,
        filter: [
          "all",
          [">=", ["get", "admin_level"], 3],
          ["<=", ["get", "admin_level"], 4],
          ["!=", ["get", "maritime"], 1],
          ["!=", ["get", "disputed"], 1],
          ["!", ["has", "claimed_by"]],
        ],
        layout: {
          "line-cap": "round",
          "line-join": "round",
        },
        paint: {
          "line-color": "#6f7775",
          "line-dasharray": [2, 1.5],
          "line-opacity": [
            "interpolate",
            ["linear"],
            ["zoom"],
            3,
            0.34,
            5,
            0.54,
            8,
            0.72,
          ],
          "line-width": [
            "interpolate",
            ["linear"],
            ["zoom"],
            3,
            0.45,
            5,
            0.7,
            8,
            1,
          ],
        },
      },
      map.getLayer("boundary_2") ? "boundary_2" : undefined,
    );

    setMapMode(currentMapMode);

    map.addSource("world-countries", {
      type: "geojson",
      data: worldCountries,
      generateId: true,
    });
    map.addLayer({
      id: "country-page-hit-area",
      type: "fill",
      source: "world-countries",
      filter: ["!=", ["get", "pageSlug"], ""],
      paint: {
        "fill-color": "rgba(0, 0, 0, 0)",
        "fill-opacity": 0,
      },
    });

    for (const layerId of countryLabelLayerIds) {
      if (!map.getLayer(layerId)) continue;
      map.setPaintProperty(layerId, "text-color", "#000000");
    }

    map.addSource("locations", {
      type: "geojson",
      data: locationGeoJson,
    });
    map.addLayer({
      id: "location-points",
      type: "circle",
      source: "locations",
      paint: {
        "circle-color": "#e6523c",
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 1, 5.5, 8, 11],
        "circle-stroke-color": "#fffdf7",
        "circle-stroke-width": 3,
      },
    });

    const initialId = new URLSearchParams(window.location.search).get("location");
    const initialLocation = initialId ? locationById.get(initialId) : undefined;
    if (initialLocation) {
      map.flyTo({ center: initialLocation.coordinates, zoom: 6, duration: 0 });
      window.setTimeout(() => {
        showLocation(
          initialLocation,
          { x: mapElement.clientWidth / 2, y: mapElement.clientHeight / 2 },
          true,
        );
      }, 80);
    }
  });

  map.on("error", (event) => {
    if (isFatalMapError(event.error)) {
      showFatalError("地图资源载入失败");
    }
  });

  map.on("mouseenter", "location-points", (event: MapLayerMouseEvent) => {
    map.getCanvas().style.cursor = "pointer";
    const location = getLocationFromFeatures(event.features);
    if (location) scheduleLocation(location, event.point);
  });
  map.on("mousemove", "location-points", (event: MapLayerMouseEvent) => {
    const location = getLocationFromFeatures(event.features);
    if (location) scheduleLocation(location, event.point);
  });
  map.on("mouseleave", "location-points", (event: MapLayerMouseEvent) => {
    map.getCanvas().style.cursor = "";
    const pointer = event.originalEvent;
    if (
      pointer instanceof MouseEvent &&
      isInPanelKeepZone(pointer.clientX, pointer.clientY)
    ) {
      cancelTimers();
      return;
    }
    scheduleClose();
  });

  const getCountrySlugFromIso2 = (iso2: unknown) => {
    if (typeof iso2 !== "string" || !iso2) return undefined;
    return countryPagesByIso2[iso2.toUpperCase()]?.slug;
  };

  const getCountrySlugFromLabelName = (properties?: GeoJsonProperties) => {
    if (!properties) return undefined;
    const names = [
      properties.iso_a2,
      properties.name,
      properties.name_en,
      properties["name:latin"],
      properties["name:nonlatin"],
    ]
      .filter((value): value is string => typeof value === "string" && value.length > 0)
      .map((value) => value.trim().toLowerCase());
    if (!names.length) return undefined;

    const match = countryPages.find((country) => {
      const aliases = [country.iso2, country.title, country.nameZh].map((value) =>
        value.trim().toLowerCase(),
      );
      return aliases.some((alias) => names.includes(alias));
    });
    return match?.slug;
  };

  const getCountrySlugFromFeatures = (features?: MapGeoJSONFeature[]) => {
    for (const feature of features ?? []) {
      const fromPageSlug = feature.properties?.pageSlug;
      if (typeof fromPageSlug === "string" && fromPageSlug) return fromPageSlug;
      const fromIso2 = getCountrySlugFromIso2(feature.properties?.iso_a2);
      if (fromIso2) return fromIso2;
      const fromName = getCountrySlugFromLabelName(feature.properties);
      if (fromName) return fromName;
    }
    return undefined;
  };

  const queryCountryLabelLayers = () =>
    countryLabelLayerIds.filter((layerId) => Boolean(map.getLayer(layerId)));

  const setCountryLabelHover = (iso2: string | null, names: string[] = []) => {
    const normalizedNames = names.map((name) => name.trim().toLowerCase());
    const nameMatches = normalizedNames.flatMap((name) => [
      ["==", ["downcase", ["coalesce", ["get", "name_en"], ""]], name],
      ["==", ["downcase", ["coalesce", ["get", "name"], ""]], name],
      ["==", ["downcase", ["coalesce", ["get", "name:latin"], ""]], name],
    ]);
    const matchers = [
      ...(iso2
        ? [["==", ["upcase", ["coalesce", ["get", "iso_a2"], ""]], iso2]]
        : []),
      ...nameMatches,
    ];
    const colorExpression = (
      matchers.length > 0
        ? ["case", ["any", ...matchers], publishedCountryColor, "#000000"]
        : "#000000"
    ) as DataDrivenPropertyValueSpecification<string>;

    for (const layerId of queryCountryLabelLayers()) {
      map.setPaintProperty(layerId, "text-color", colorExpression);
    }
  };

  let hoveredCountryIso2: string | null = null;

  const updateCountryHoverFromPoint = (point: PointLike) => {
    const labelLayers = queryCountryLabelLayers();
    const labelFeatures = labelLayers.length
      ? map.queryRenderedFeatures(point, { layers: labelLayers })
      : [];
    const hoveredIso2 =
      typeof labelFeatures[0]?.properties?.iso_a2 === "string"
        ? String(labelFeatures[0].properties.iso_a2).toUpperCase()
        : null;
    const slugFromLabel = getCountrySlugFromFeatures(labelFeatures);
    const fillFeatures = map.getLayer("country-page-hit-area")
      ? map.queryRenderedFeatures(point, { layers: ["country-page-hit-area"] })
      : [];
    const slugFromFill = getCountrySlugFromFeatures(fillFeatures);
    const slug = slugFromLabel ?? slugFromFill;
    const hoverKey = slugFromLabel ? (hoveredIso2 ?? slugFromLabel) : null;

    if (hoveredCountryIso2 === hoverKey) {
      map.getCanvas().style.cursor = slug ? "pointer" : "";
      return;
    }

    hoveredCountryIso2 = hoverKey;
    const hoveredPage = countryPages.find((country) => country.slug === slugFromLabel);
    setCountryLabelHover(
      hoveredIso2 && slugFromLabel ? hoveredIso2 : null,
      hoveredPage ? [hoveredPage.title, hoveredPage.nameZh] : [],
    );
    map.getCanvas().style.cursor = slug ? "pointer" : "";
  };

  map.on("mousemove", (event: MapMouseEvent) => {
    const locationFeatures = map.queryRenderedFeatures(event.point, {
      layers: ["location-points"],
    });
    if (locationFeatures.length) {
      if (hoveredCountryIso2) {
        hoveredCountryIso2 = null;
        setCountryLabelHover(null, []);
      }
      return;
    }

    if (!panel.hidden && !panelPinned) {
      const client = clientPointFromMapEvent(event);
      if (isInPanelKeepZone(client.x, client.y)) {
        cancelTimers();
      } else {
        scheduleClose();
      }
    }

    updateCountryHoverFromPoint(event.point);
  });

  map.on("mouseout", (event: MapMouseEvent) => {
    hoveredCountryIso2 = null;
    setCountryLabelHover(null, []);

    if (panel.hidden || panelPinned) return;
    const pointer = event.originalEvent;
    if (
      pointer instanceof MouseEvent &&
      isInPanelKeepZone(pointer.clientX, pointer.clientY)
    ) {
      cancelTimers();
      return;
    }
    scheduleClose();
  });

  map.on("click", (event: MapMouseEvent) => {
    const locationFeatures = map.queryRenderedFeatures(event.point, {
      layers: ["location-points"],
    });
    const location = getLocationFromFeatures(locationFeatures);
    if (location) {
      showLocation(location, event.point, true);
      return;
    }

    const countryLayers = [
      ...queryCountryLabelLayers(),
      "country-page-hit-area",
    ].filter((layerId) => Boolean(map.getLayer(layerId)));
    const countryFeatures = countryLayers.length
      ? map.queryRenderedFeatures(event.point, { layers: countryLayers })
      : [];
    const countrySlug = getCountrySlugFromFeatures(countryFeatures);
    if (countrySlug) {
      window.location.href = joinBase(`${countrySlug}/`);
      return;
    }

    hidePanel(true);
  });

  panel.addEventListener("mouseenter", cancelTimers);
  panel.addEventListener("mouseleave", (event: MouseEvent) => {
    if (isInPanelKeepZone(event.clientX, event.clientY)) {
      cancelTimers();
      return;
    }
    scheduleClose();
  });
  panelClose.addEventListener("click", () => hidePanel(true));
  lightboxBackdrop.addEventListener("click", closeLightbox);
  lightboxCollapse.addEventListener("click", (event) => {
    event.preventDefault();
    event.stopPropagation();
    closeLightbox();
  });
  window.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (!lightbox.hidden) {
      closeLightbox();
      return;
    }
    hidePanel(true);
  });
  window.addEventListener("resize", () => {
    if (!panel.hidden) positionPanel();
    if (!lightbox.hidden) {
      sizeLightboxImage(
        lightboxImage.naturalWidth || 640,
        lightboxImage.naturalHeight || 360,
      );
    }
  });
</script>
